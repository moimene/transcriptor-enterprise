# ==========================================
# Transcriptor Enterprise - Backend Variables
# ==========================================

# Port and Environment
PORT=8000
ENVIRONMENT=production
DEBUG=False

# OpenAI Commercial API (Zero Data Retention)
OPENAI_API_KEY=sk-proj-...
WHISPER_MODEL=whisper-1
SUMMARY_MODEL=gpt-4o-mini

# Audio Processing Settings
MAX_UPLOAD_SIZE_MB=1024
TARGET_BITRATE=32k
TARGET_SAMPLE_RATE=16000
MAX_CHUNK_SIZE_MB=24.0

# Storage S3 / Cloudflare R2 (Optional for direct client presigned uploads up to 1GB)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=transcriptions-ephemeral
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_REGION=auto
PRESIGNED_EXPIRATION_SECONDS=1800

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,https://*.vercel.app,https://*.railway.app
